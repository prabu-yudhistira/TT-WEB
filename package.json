{
  "name": "tampa-taruno-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:push": "PAYLOAD_DEV_PUSH=true node --env-file=.env --import tsx src/seed/push.ts",
    "seed": "PAYLOAD_DEV_PUSH=true node --env-file=.env --import tsx src/seed/index.ts",
    "seed:verify": "node --env-file=.env --import tsx src/seed/verify.ts",
    "seed:semesta": "PAYLOAD_DEV_PUSH=true node --env-file=.env --import tsx src/seed/semesta.ts",
    "seed:planets-demo": "PAYLOAD_DEV_PUSH=true node --env-file=.env --import tsx src/seed/planetsDemo.ts",
    "verify:config": "node --import tsx src/lib/three/shatter/resolveSeparation.check.ts && node --import tsx src/lib/three/ignition/resolveIgnition.check.ts && node --import tsx src/lib/three/ignition/cage.check.ts && node --import tsx src/lib/three/ignition/ignitionMaterial.check.ts && node --import tsx src/lib/three/ignition/IgnitionController.check.ts && node --import tsx src/lib/orbit/placement.check.ts && node --import tsx src/lib/map/projection.check.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-sqlite": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@react-three/fiber": "^9.6.1",
    "graphql": "^16.9.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "~15.4.11",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
